# The DemoLauncher.exe that CI puts beside DemoHub.exe in the player zip
# (.github/workflows/ci.yml, "Get the launcher"). Change both lines together:
# DEMO_LAUNCHER_TAG is a release of Contact-Control-Interfaces/demo-launcher,
# and DEMO_LAUNCHER_SHA256 is the SHA-256 of DemoLauncher.exe itself, not of
# the zip it comes in. The build fails if the downloaded exe doesn't match.
DEMO_LAUNCHER_TAG=v1.0.1
DEMO_LAUNCHER_SHA256=fe53c3b0a7dccf18dd261826e378ba37a4a765d61ed38572f780fd2eef467aba
